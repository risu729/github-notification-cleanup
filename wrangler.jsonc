// ref: https://developers.cloudflare.com/workers/wrangler/configuration
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "7f77b37c-5fac-46e2-8a69-28211419dbb3",
      "database_name": "github-notification-cleanup",
      "migrations_dir": "migrations",
    },
  ],
  "main": "src/index.ts",
  "name": "github-notification-cleanup",
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "preview_urls": false,
  "secrets": {
    "required": ["GH_TOKEN"],
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "upload_source_maps": true,
  "workers_dev": false,
}
