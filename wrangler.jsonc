// ref: https://developers.cloudflare.com/workers/wrangler/configuration
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "1a52ac9d-62e6-40b7-93c8-31ec58e49075",
      "database_name": "github-notification-cleanup",
      "migrations_dir": "migrations",
    },
  ],
  "main": "src/index.ts",
  "name": "github-notification-cleanup",
  "observability": {
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "github-notification-cleanup-failures",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 7,
        "queue": "github-notification-cleanup-notifications",
      },
      {
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 7,
        "queue": "github-notification-cleanup-failures",
        "retry_delay": 600,
      },
    ],
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "github-notification-cleanup-notifications",
      },
    ],
  },
  "secrets": {
    "required": ["GH_TOKEN"],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "upload_source_maps": true,
  "vars": {
    "DEAD_LETTER_QUEUE_NAME": "github-notification-cleanup-failures",
  },
  "workers_dev": false,
}
